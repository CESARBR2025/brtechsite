# Copiar a .env.local y rellenar. En producción se define en Dokploy.

# Postgres. En prod: postgresql://brtech_app:<pwd>@parrillasoft-db:5432/brtech_site
# En dev: túnel SSH al VPS -> 127.0.0.1:5433
DATABASE_URL=postgresql://brtech_app:CAMBIA_ESTO@127.0.0.1:5433/brtech_site

# Máximo de conexiones del pool (se mantiene bajo: Postgres es compartido con parrilla)
DB_POOL_MAX=3

# Acceso al panel de captura (/panel). 8+ caracteres.
PANEL_PASSWORD=CAMBIA_ESTO

# Secreto para firmar la cookie de sesión del panel. 16+ caracteres.
# Generar con: openssl rand -hex 32
PANEL_SESSION_SECRET=CAMBIA_ESTO

# URL pública del sitio (para metadatos y enlaces absolutos)
SITE_URL=https://brtech...

# Envío de correo del formulario de contacto (opcional en dev)
RESEND_API_KEY=
CONTACT_TO_EMAIL=barcenasrosalescesarivan@gmail.com
